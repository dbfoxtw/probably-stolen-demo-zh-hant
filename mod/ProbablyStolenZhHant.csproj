<Project Sdk="Microsoft.NET.Sdk">

  <!-- 編譯前要先裝好 MelonLoader 並啟動過一次遊戲（會產生 MelonLoader\Il2CppAssemblies）。
       遊戲不在預設位置時：dotnet build -p:GameDir="遊戲資料夾" -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>ProbablyStolenZhHant</AssemblyName>
    <RootNamespace>ProbablyStolenZhHant</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GameDir Condition="'$(GameDir)' == ''">D:\SteamLibrary\steamapps\common\Probably Stolen Demo</GameDir>
    <MelonDir>$(GameDir)\MelonLoader</MelonDir>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="verify/**" />
    <Reference Include="$(MelonDir)\net6\MelonLoader.dll" Private="false" />
    <Reference Include="$(MelonDir)\net6\0Harmony.dll" Private="false" />
    <Reference Include="$(MelonDir)\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(MelonDir)\Il2CppAssemblies\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(MelonDir)\Il2CppAssemblies\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(MelonDir)\Il2CppAssemblies\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(MelonDir)\Il2CppAssemblies\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(MelonDir)\Il2CppAssemblies\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(MelonDir)\Il2CppAssemblies\UnityEngine.TextCoreFontEngineModule.dll" Private="false" />
    <Reference Include="$(MelonDir)\Il2CppAssemblies\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(MelonDir)\Il2CppAssemblies\Unity.Localization.dll" Private="false" />
    <Reference Include="$(MelonDir)\Il2CppAssemblies\Unity.ResourceManager.dll" Private="false" />
  </ItemGroup>

</Project>
